<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The iPhone app's store (Cue.entitlements), so book places cross
	     through iCloud with the two out of reach (CloudBookPlaces). -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(BUNDLE_ID)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dance.cue</string>
	</array>
</dict>
</plist>
