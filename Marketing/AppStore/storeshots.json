{
  "app": "Cue",
  "bundleID": "dance.cue",
  "launch": [
    "-dance.cue.blurArtwork",
    "YES"
  ],
  "icon": "../../build/app-store/icon.png",
  "raw": "../../build/app-store/raw",
  "clips": "../../build/app-store/clips",
  "output": "../../build/app-store/output",
  "theme": {
    "base": "#050706",
    "palette": [
      "#059669"
    ],
    "accent": "#34D399",
    "titleWeight": "bold",
    "design": "rounded",
    "finish": "graphite"
  },
  "devices": {
    "iphone": {
      "model": "iphone-6.3",
      "simulator": "iPhone 18 Pro"
    },
    "duo": {
      "model": "iphone-duo",
      "simulator": "iPhone Duo",
      "display": "primary-1",
      "landscape": true
    },
    "ipad": {
      "model": "ipad-13",
      "simulator": "iPad Pro 13-inch (M5)",
      "deviceWidth": 0.88
    },
    "watch": {
      "model": "watch-46",
      "simulator": "Apple Watch Series 12 (46mm)",
      "bare": true,
      "statusBar": false
    }
  },
  "shots": [
    {
      "name": "player",
      "layout": "hero",
      "title": "All your music. *One player.*",
      "subtitle": "Apple Music, Plex, Subsonic, radio and your own files, from your pocket to every room.",
      "overrides": {
        "ipad": {
          "subtitle": "Apple Music, Plex, Subsonic, radio and your own files, on your iPad and in every room.",
          "screen": "queue"
        }
      }
    },
    {
      "name": "library",
      "devices": [
        "iphone",
        "ipad"
      ],
      "title": "Every library, *side by side*",
      "subtitle": "Apple Music, Plex, Subsonic and Audiobookshelf, a tap apart.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b2262726f777365223a7b7d7d>"
      ],
      "wait": 9,
      "overrides": {
        "iphone": {
          "screen": "services"
        },
        "ipad": {
          "screen": "services",
          "subtitle": "Apple Music, Plex, Subsonic and your own files, a tap apart."
        }
      }
    },
    {
      "name": "playon",
      "title": "Play here *or on Sonos*",
      "subtitle": "Hand your queue to any room without missing a beat."
    },
    {
      "name": "queue",
      "title": "Your queue, *your way*",
      "subtitle": "Drag, swipe and play next, right from Up Next.",
      "devices": [
        "iphone",
        "duo"
      ]
    },
    {
      "name": "audiobooks",
      "title": "Books, *right where you left off*",
      "subtitle": "Plex and Audiobookshelf audiobooks, with chapters and Smart Resume.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b22617564696f626f6f6b73223a7b7d7d>"
      ],
      "wait": 9,
      "overrides": {
        "ipad": {
          "screen": "book",
          "subtitle": "Plex and Audiobookshelf audiobooks, with their chapters and Smart Resume."
        },
        "duo": {
          "screen": "book",
          "subtitle": "Plex and Audiobookshelf audiobooks, with their chapters and Smart Resume."
        }
      }
    },
    {
      "name": "radio",
      "title": "Radio from *everywhere*",
      "subtitle": "Local and world stations, live in one tap.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b22726164696f223a7b7d7d>"
      ],
      "wait": 9,
      "overrides": {
        "ipad": {
          "bleed": true
        }
      }
    },
    {
      "name": "watch",
      "layout": "pair",
      "devices": [
        "iphone"
      ],
      "companion": {
        "device": "watch",
        "screen": "now-playing"
      },
      "title": "On your wrist, *no iPhone needed*",
      "subtitle": "Plex and Subsonic songs and books, downloaded to Apple Watch.",
      "overrides": {
        "iphone": {
          "screen": "book"
        }
      }
    },
    {
      "name": "album",
      "devices": [
        "iphone",
        "ipad"
      ],
      "title": "Your own server, *in lossless*",
      "subtitle": "FLAC and ALAC straight from Plex and Subsonic."
    },
    {
      "name": "search",
