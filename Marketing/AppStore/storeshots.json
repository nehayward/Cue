{
  "app": "Cue",
  "bundleID": "dance.cue",
  "launch": [
    "-dance.cue.blurArtwork",
    "YES"
  ],
  "icon": "../../build/app-store/icon.png",
  "raw": "../../build/app-store/raw",
  "clips": "../../build/app-store/clips",
  "output": "../../build/app-store/output",
  "theme": {
    "base": "#06090A",
    "palette": [
      "#2F9E6E",
      "#1E8C8C",
      "#2F62A8",
      "#4A49A6",
      "#B27628",
      "#A3456C",
      "#6A45A8",
      "#2F8F86",
      "#3A6FB0",
      "#2F9E6E"
    ],
    "accent": "#6FE0A6",
    "titleWeight": "bold",
    "design": "rounded",
    "finish": "graphite"
  },
  "devices": {
    "iphone": {
      "model": "iphone-6.3",
      "simulator": "iPhone 18 Pro"
    },
    "duo": {
      "model": "iphone-duo",
      "simulator": "iPhone Duo",
      "display": "primary-1",
      "landscape": true
    },
    "ipad": {
      "model": "ipad-13",
      "simulator": "iPad Pro 13-inch (M5)",
      "deviceWidth": 0.88,
      "bleed": true
    },
    "watch": {
      "model": "watch-46",
      "simulator": "Apple Watch Series 12 (46mm)",
      "bare": true,
      "statusBar": false
    }
  },
  "shots": [
    {
      "name": "player",
      "layout": "hero",
      "title": "All your music. *One player.*",
      "subtitle": "Apple Music, Plex, Subsonic, radio and your own files, on this iPhone or on Sonos.",
      "overrides": {
        "ipad": {
          "screen": "library",
          "subtitle": "Apple Music, Plex, Subsonic, radio and your own files, on this iPad or on Sonos."
        },
        "duo": {
          "screen": "library"
        }
      }
    },
    {
      "name": "library",
      "devices": [
        "iphone"
      ],
      "title": "Every library, *side by side*",
      "subtitle": "Apple Music, Plex, Subsonic and Audiobookshelf, a tap apart.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b2262726f777365223a7b7d7d>"
      ],
      "wait": 9,
      "overrides": {
        "iphone": {
          "screen": "services"
        }
      }
    },
    {
      "name": "playon",
      "title": "Play here *or on Sonos*",
      "subtitle": "Hand your queue to any room without missing a beat."
    },
    {
      "name": "queue",
      "title": "Your queue, *your way*",
      "subtitle": "Drag, swipe and play next, right from Up Next."
    },
    {
      "name": "audiobooks",
      "title": "Books, *right where you left off*",
      "subtitle": "Plex and Audiobookshelf audiobooks, with chapters and Smart Resume.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b22617564696f626f6f6b73223a7b7d7d>"
      ],
      "wait": 9
    },
    {
      "name": "transcript",
      "title": "Read along *as you listen*",
      "subtitle": "The book's words on screen, lit up as they're read."
    },
    {
      "name": "radio",
      "title": "Radio from *everywhere*",
      "subtitle": "Local and world stations, live in one tap.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b22726164696f223a7b7d7d>"
      ],
      "wait": 9
    },
    {
      "name": "watch",
      "layout": "pair",
      "devices": [
        "iphone"
      ],
      "companion": {
        "device": "watch",
        "screen": "now-playing"
      },
      "title": "On your wrist, *no iPhone needed*",
      "subtitle": "Plex and Subsonic songs and books, downloaded to Apple Watch.",
      "overrides": {
        "iphone": {
          "screen": "book"
        }
      }
    },
    {
      "name": "album",
      "devices": [
        "iphone"
      ],
      "title": "Your own server, *in lossless*",
      "subtitle": "FLAC and ALAC straight from Plex and Subsonic."
    },
    {
      "name": "search",
      "title": "Search *everything* at once",
      "subtitle": "One search across every service you use.",
      "launch": [
        "-dance.cue.selectedTab",
        "<7b22736561726368223a7b7d7d>"
      ],
      "wait": 9
